# Keystone material library (SIM-01). Values for engineering estimates; check your supplier's certificate
# or data sheet for critical parts. Strength basis and source are in the BruceWorx block below.
General:
  UUID: "b4e991ce-42af-48ad-acbc-40e7f1de3a52"
  Author: "BruceWorx (Keystone)"
  License: "LGPL-2.1-or-later"
  Name: "PETG printed"
  Description: "Printed PETG (Bambu PETG Basic; Prusament PETG agrees: 47 MPa, 1.5 GPa X-Y). For high-speed PETG use PETG HF printed. Printed ISO 527 specimens, 100 % infill, X-Y (in-layer); the X-Y tensile strength is used as the yield. Z (between layers) tensile strength 39 MPa, modulus 1120 MPa, elongation 5.7 %. Thermal values are bulk-polymer estimates."
  ReferenceSource: "Bambu Lab TDS (PETG Basic)"
  SourceURL: "https://cdn.shopify.com/s/files/1/0380/5149/files/Bambu_PETG_Basic_Technical_Data_Sheet.pdf"
  Tags:
    - "Keystone"
    - "Printed"
Models:
  LinearElastic:
    UUID: '7b561d1d-fb9b-44f6-9da9-56a4f74d7536'
    Density: "1250 kg/m^3"
    YoungsModulus: "1460 MPa"
    PoissonRatio: "0.38"
    YieldStrength: "48 MPa"
    UltimateTensileStrength: "48 MPa"
    UltimateStrain: "11.2"
  Thermal:
    UUID: '9959d007-a970-4ea7-bae4-3eb1b8b883c7'
    ThermalConductivity: "0.2 W/m/K"
    SpecificHeat: "1200 J/kg/K"
    ThermalExpansionCoefficient: "60 µm/m/K"
AppearanceModels:
  BasicRendering:
    UUID: 'f006c7e4-35b7-43d5-bbf9-c5d572309e6e'
    AmbientColor: "(0.0800, 0.2600, 0.2200, 1.0)"
    DiffuseColor: "(0.2000, 0.6500, 0.5500, 1.0)"
    EmissiveColor: "(0.0000, 0.0000, 0.0000, 1.0)"
    Shininess: "0.2000"
    SpecularColor: "(0.2500, 0.2500, 0.2500, 1.0)"
    Transparency: "0.0000"
