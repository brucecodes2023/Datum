# Keystone material library (SIM-01). Values for engineering estimates; check your supplier's certificate
# or data sheet for critical parts. Strength basis and source are in the BruceWorx block below.
General:
  UUID: "3e80c57d-cc7d-4110-b63e-d8e4df8053b3"
  Author: "BruceWorx (Keystone)"
  License: "LGPL-2.1-or-later"
  Name: "PA6-CF printed"
  Description: "Printed carbon-fibre PA6 (Bambu PA6-CF), dry state: strength drops markedly once it absorbs moisture. Printed ISO 527 specimens, 100 % infill, X-Y (in-layer); the X-Y tensile strength is used as the yield. Z (between layers) tensile strength 48 MPa, modulus 2170 MPa, elongation 3.7 %. Thermal values are bulk-polymer estimates."
  ReferenceSource: "Bambu Lab TDS (PA6-CF, dry)"
  SourceURL: "https://cdn.shopify.com/s/files/1/0584/7236/6216/files/Bambu_PA6-CF_Technical_Data_Sheet.pdf"
  Tags:
    - "Keystone"
    - "Printed"
Models:
  LinearElastic:
    UUID: '7b561d1d-fb9b-44f6-9da9-56a4f74d7536'
    Density: "1090 kg/m^3"
    YoungsModulus: "4430 MPa"
    PoissonRatio: "0.35"
    YieldStrength: "102 MPa"
    UltimateTensileStrength: "102 MPa"
    UltimateStrain: "5.8"
  Thermal:
    UUID: '9959d007-a970-4ea7-bae4-3eb1b8b883c7'
    ThermalConductivity: "0.3 W/m/K"
    SpecificHeat: "1500 J/kg/K"
    ThermalExpansionCoefficient: "35 µm/m/K"
AppearanceModels:
  BasicRendering:
    UUID: 'f006c7e4-35b7-43d5-bbf9-c5d572309e6e'
    AmbientColor: "(0.0640, 0.0640, 0.0680, 1.0)"
    DiffuseColor: "(0.1600, 0.1600, 0.1700, 1.0)"
    EmissiveColor: "(0.0000, 0.0000, 0.0000, 1.0)"
    Shininess: "0.2000"
    SpecularColor: "(0.2500, 0.2500, 0.2500, 1.0)"
    Transparency: "0.0000"
