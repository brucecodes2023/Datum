# Keystone material library (SIM-01). Values for engineering estimates; check your supplier's certificate
# or data sheet for critical parts. Strength basis and source are in the BruceWorx block below.
General:
  UUID: "88dae26a-37a2-4691-953a-3ba452740878"
  Author: "BruceWorx (Keystone)"
  License: "LGPL-2.1-or-later"
  Name: "ABS printed"
  Description: "Printed ABS (Bambu ABS, enclosure). Printed ISO 527 specimens, 100 % infill, X-Y (in-layer); the X-Y tensile strength is used as the yield. Z (between layers) tensile strength 32 MPa, modulus 1960 MPa, elongation 4.7 %. Thermal values are bulk-polymer estimates."
  ReferenceSource: "Bambu Lab TDS (ABS)"
  SourceURL: "https://cdn.shopify.com/s/files/1/0584/7236/6216/files/Bambu_ABS_Technical_Data_Sheet.pdf"
  Tags:
    - "Keystone"
    - "Printed"
Models:
  LinearElastic:
    UUID: '7b561d1d-fb9b-44f6-9da9-56a4f74d7536'
    Density: "1050 kg/m^3"
    YoungsModulus: "2200 MPa"
    PoissonRatio: "0.35"
    YieldStrength: "41 MPa"
    UltimateTensileStrength: "41 MPa"
    UltimateStrain: "10.5"
  Thermal:
    UUID: '9959d007-a970-4ea7-bae4-3eb1b8b883c7'
    ThermalConductivity: "0.17 W/m/K"
    SpecificHeat: "1400 J/kg/K"
    ThermalExpansionCoefficient: "90 µm/m/K"
