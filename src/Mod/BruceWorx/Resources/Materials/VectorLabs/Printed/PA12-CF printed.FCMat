  LinearElastic:
    UUID: '7b561d1d-fb9b-44f6-9da9-56a4f74d7536'
    Density: "1060 kg/m^3"
    YoungsModulus: "3860 MPa"
    PoissonRatio: "0.35"
    YieldStrength: "88 MPa"
    UltimateTensileStrength: "88 MPa"
