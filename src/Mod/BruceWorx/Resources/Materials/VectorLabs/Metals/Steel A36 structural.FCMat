# Keystone material library (SIM-01). Values for engineering estimates; check your supplier's certificate
# or data sheet for critical parts. Strength basis and source are in the BruceWorx block below.
General:
  UUID: "cd8cd9f3-25a1-43fa-880a-e49821b97b0e"
  Author: "BruceWorx (Keystone)"
  License: "LGPL-2.1-or-later"
  Name: "Steel A36 structural"
  Description: "Carbon structural steel (UNS K02600; EN S235 is the nearest equivalent): plate, flat bar, angle and channel for frames and welded bases. Strengths are ASTM A36 minimums, 36 ksi yield and 58 ksi UTS, elongation 20 % in 200 mm. Mill certificates usually show more, and much angle and channel is dual-certified A36/A572-50 (yield 345 MPa); use that only with the certificate."
  ReferenceSource: "ASTM A36 minimums (UTS 400-550 MPa range, lower end used); ASM/MatWeb elastic and thermal values"
  SourceURL: "https://www.astm.org/a0036_a0036m-19.html"
  Tags:
    - "Keystone"
    - "Metals"
Models:
  LinearElastic:
    UUID: '7b561d1d-fb9b-44f6-9da9-56a4f74d7536'
    Density: "7850 kg/m^3"
    YoungsModulus: "200000 MPa"
    PoissonRatio: "0.26"
    ShearModulus: "79300 MPa"
    YieldStrength: "250 MPa"
    UltimateTensileStrength: "400 MPa"
    UltimateStrain: "20"
  Thermal:
    UUID: '9959d007-a970-4ea7-bae4-3eb1b8b883c7'
    ThermalConductivity: "51.9 W/m/K"
    SpecificHeat: "486 J/kg/K"
    ThermalExpansionCoefficient: "11.7 µm/m/K"
AppearanceModels:
  BasicRendering:
    UUID: 'f006c7e4-35b7-43d5-bbf9-c5d572309e6e'
    AmbientColor: "(0.1440, 0.1440, 0.1520, 1.0)"
    DiffuseColor: "(0.3600, 0.3600, 0.3800, 1.0)"
    EmissiveColor: "(0.0000, 0.0000, 0.0000, 1.0)"
    Shininess: "0.4000"
    SpecularColor: "(0.6000, 0.6000, 0.6000, 1.0)"
    Transparency: "0.0000"
# Read by BruceWorx (bruceworx_materials, later the vault library PDM-11); FreeCAD ignores this block.
BruceWorx:
  Family: "Metals"
  Basis: "minimum"
  YieldBasis: "ASTM A36 minimum yield 36 ksi (plates, shapes and bars up to 203 mm)"
  Brittle: false
