# Vector Labs material library (SIM-01). Values for engineering estimates; check your supplier's certificate
# or data sheet for critical parts. Strength basis and source are in the BruceWorx block below.
General:
  UUID: "aa3ad6d8-8b66-47a7-b6bd-cbe012cbf747"
  Author: "BruceWorx (Vector Labs)"
  License: "LGPL-2.1-or-later"
  Name: "POM-H Delrin 150"
  Description: "Acetal homopolymer (POM-H, Delrin 150 extrusion grade); stiffer and stronger than POM-C."
  ReferenceSource: "DuPont Delrin 150 NC010 product data (ISO 527)"
  SourceURL: "https://plastics.tridentplastics.com/Asset/TDS_Delrin_150_NC010_(E_71946).pdf"
  Tags:
    - "Vector Labs"
    - "Plastics"
Models:
  LinearElastic:
    UUID: '7b561d1d-fb9b-44f6-9da9-56a4f74d7536'
    Density: "1420 kg/m^3"
    YoungsModulus: "3100 MPa"
    PoissonRatio: "0.35"
    YieldStrength: "72 MPa"
    UltimateTensileStrength: "72 MPa"
    UltimateStrain: "40"
  Thermal:
    UUID: '9959d007-a970-4ea7-bae4-3eb1b8b883c7'
    ThermalConductivity: "0.31 W/m/K"
    SpecificHeat: "1470 J/kg/K"
    ThermalExpansionCoefficient: "110 µm/m/K"
AppearanceModels:
  BasicRendering:
    UUID: 'f006c7e4-35b7-43d5-bbf9-c5d572309e6e'
    AmbientColor: "(0.3880, 0.3880, 0.3800, 1.0)"
