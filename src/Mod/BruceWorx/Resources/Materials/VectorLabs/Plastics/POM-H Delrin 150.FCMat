# Read by BruceWorx (bruceworx_materials, later the vault library PDM-11); FreeCAD ignores this block.
BruceWorx:
  Family: "Plastics"
  Basis: "typical"
  YieldBasis: "tensile stress at yield (= tensile strength), ISO 527"
  Brittle: false
  Elongation: "40 %"
