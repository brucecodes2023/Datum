<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>BruceWorxPreferences</class>
 <widget class="QWidget" name="BruceWorxPreferences">
  <property name="windowTitle">
   <string>BruceWorx</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="groupDefaults">
     <property name="title">
      <string>BruceWorx features</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutDefaults">
      <item>
       <widget class="QLabel" name="labelDefaults">
        <property name="text">
         <string>Everything BruceWorx adds is on by default. Uncheck a box to turn that feature off.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="PreferencePack">
        <property name="toolTip">
         <string>On by default. Applied once on first start (theme, millimetres, Fusion-like navigation, PartDesign startup). Your previous values are saved first. Uncheck to restore them (same as the BruceWorx Off pack); check to apply the light pack again. Preferences &gt; General &gt; Theme still picks BruceWorx Dark or another theme.</string>
        </property>
        <property name="text">
         <string>BruceWorx preference pack</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>PreferencePack</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="HistoryTimelineEnabled">
        <property name="toolTip">
         <string>On by default. Same switch as BruceWorx &gt; History Timeline. Closing the dock also turns it off.</string>
        </property>
        <property name="text">
         <string>History timeline (bottom bar: PartDesign history, assembly order)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>Enabled</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Mod/HistoryTimeline</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="HistoryTimelineHideWhenEmpty">
        <property name="toolTip">
         <string>On by default. The timeline hides while the active document has no history (no body with features, no assembly) and comes back when it has. Uncheck to keep it visible with a short message.</string>
        </property>
        <property name="text">
         <string>Hide the history timeline when there is no history</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>HideWhenEmpty</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Mod/HistoryTimeline</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="LoadHooks">
        <property name="toolTip">
         <string>On by default. Loads the BruceWorx hooks add-on (Mod/BruceWorxHooks). Takes effect on the next start. The FreeCADCmd hooks.py CLI does not depend on this box.</string>
        </property>
        <property name="text">
         <string>Hooks add-on (part numbers: BruceWorx &gt; Assign Part Number…)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>LoadHooks</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="VaultStateSync">
        <property name="toolTip">
         <string>On by default. A part's Lifecycle State (WIP, In Review, Released, Obsolete) follows the vault: it is written on every vault transition made in FreeCAD, and taken from the vault named by BruceWorx/VaultPath when a document opens. Needs the hooks add-on.</string>
        </property>
        <property name="text">
         <string>Lifecycle state of parts follows the vault</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>VaultStateSync</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="DrawingAutoFill">
        <property name="toolTip">
         <string>On by default. Drawings on the BruceWorx sheet templates fill their title block from the part (number, revision, title, material, finish, mass) and the open vault (company, logo, tolerances, standard, projection, who drew, checked and approved). Fields you type yourself are kept. Needs the hooks add-on.</string>
        </property>
        <property name="text">
         <string>Fill drawing title blocks from the part and the vault</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>DrawingAutoFill</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="VaultClient">
        <property name="toolTip">
         <string>On by default. Check out and check in from FreeCAD: the Vault panel, vault status in the Browser and the status bar, a check-out offer when you save or edit a vault file that is not checked out to you, and no backup files for vault files. Needs the hooks add-on.</string>
        </property>
        <property name="text">
         <string>Vault client: check out, check in, Vault panel</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>VaultClient</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="ClaudeBridge">
        <property name="toolTip">
         <string>On by default. Lets Claude Code (the BruceWorx MCP server in this repository) read and change FreeCAD over a local connection from this Mac only. The first call asks you (tick "Don't ask again" to be asked only once); a "Claude connected" chip in the status bar disconnects it. Every call is listed in the Report view and in bridge.log in the FreeCAD user data folder.</string>
        </property>
        <property name="text">
         <string>Claude Code bridge</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>ClaudeBridge</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="TreeActiveDocumentOnly">
        <property name="toolTip">
         <string>On by default. The model tree lists only the active document. Documents open because something links to them are not listed on their own; their objects still show under the links that use them. Also in the tree's right-click menu under Tree Settings.</string>
        </property>
        <property name="text">
         <string>Model tree: active document only</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>ActiveDocumentOnly</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>TreeView</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="ClaudeBridgeAlways">
        <property name="toolTip">
         <string>Set by the Allow prompt's "Don't ask again on this Mac" box (or BruceWorx &gt; Allow Claude Code). On, every start of FreeCAD lets Claude Code in without asking, with the "Claude connected" chip showing. Untick it, Deny, or click the chip to be asked again.</string>
        </property>
        <property name="text">
         <string>Allow Claude Code without asking (remembered)</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>ClaudeBridgeAlways</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="SaveBinaryBrep">
        <property name="toolTip">
         <string>On by default (PRF-01). Shapes are saved in OpenCascade's binary form instead of text: about 40 % faster to open and twice as fast to save on large assemblies, lossless. FreeCAD opens both forms, so older files and other FreeCAD versions still work. Off saves text again.</string>
        </property>
        <property name="text">
         <string>Save shapes in binary (faster open and save)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>SaveBinaryBrep</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Document</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="PatternCommands">
        <property name="toolTip">
         <string>On by default. Adds Rectangular Pattern and Circular Pattern to the PartDesign and Assembly toolbars and to the BruceWorx menu. They pattern features (through PartDesign), bodies and assembly components. Takes effect on the next workbench switch.</string>
        </property>
        <property name="text">
         <string>Rectangular and Circular Pattern commands</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>PatternCommands</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="KiCadBoards">
        <property name="toolTip">
         <string>On by default. Adds Insert Board… (Assemble group and BruceWorx menu): a KiCad board as one part, exported to STEP by KiCad, with FR-4, copper and component materials, its mass, and coordinate systems at the board origin and mounting holes.</string>
        </property>
        <property name="text">
         <string>KiCad boards (Insert Board command)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>KiCadBoards</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="SheetMetalAddon">
        <property name="toolTip">
         <string>On by default. Loads the bundled SheetMetal add-on (Mod/SheetMetal) and shows the Design &gt; Sheet Metal tab: base wall, flanges, relief, unfold, and BruceWorx's sheet-metal rules and Export Flat (shop DXF). Off skips any SheetMetal add-on, a copy from the Addon Manager too. Takes effect on the next start.</string>
        </property>
        <property name="text">
         <string>Sheet metal add-on (Design &gt; Sheet Metal tab)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>SheetMetalAddon</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="SheetMetalAutoRule">
        <property name="toolTip">
         <string>On by default. The first sheet-metal wall of a document without a rule gets the vault's default sheet-metal rule (thickness, bend radius, K-factor, relief); change it with Sheet Metal &gt; Rules.</string>
        </property>
        <property name="text">
         <string>New sheet-metal parts take the vault's default rule</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>SheetMetalAutoRule</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="HardwareCommands">
        <property name="toolTip">
         <string>On by default. Hole Preset (heat-set insert, tapped, clearance, counterbore and countersink holes), Cosmetic Thread, Hole Callouts on drawings, Insert Fastener and Mark as COTS. Takes effect at once for the buttons' state.</string>
        </property>
        <property name="text">
         <string>Hole presets, cosmetic threads and the fastener library</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>HardwareCommands</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FastenersAddon">
        <property name="toolTip">
         <string>On by default. Loads the bundled Fasteners add-on (Mod/fasteners: ISO / DIN screws, nuts, washers, inserts) that Insert Fastener uses. Off skips any Fasteners add-on, a copy from the Addon Manager too. Takes effect on the next start.</string>
        </property>
        <property name="text">
         <string>Fasteners add-on (Insert Fastener)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FastenersAddon</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="UseBruceWorxBar">
        <property name="toolTip">
         <string>On by default. Add-ons that replace the toolbar area (FreeCAD-Ribbon) are not loaded while this is on; they stay installed, and stock FreeCAD still loads them. Takes effect on the next start.</string>
        </property>
        <property name="text">
         <string>BruceWorx top bar (turns the FreeCAD-Ribbon add-on off)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>UseBruceWorxBar</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="CompactToolbars">
        <property name="toolTip">
         <string>On by default. After each workbench switch, File, the workbench tabs and View share the first toolbar row and the workbench's tools follow on the second.</string>
        </property>
        <property name="text">
         <string>Two toolbar rows</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>CompactToolbars</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="GroupCaptions">
        <property name="toolTip">
         <string>On by default. Each workbench toolbar gets a small caption under it (CREATE, PATTERN, ...). Click a caption for a menu with every command of the group, named.</string>
        </property>
        <property name="text">
         <string>Captioned tool groups</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>GroupCaptions</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="WorkspaceBar">
        <property name="toolTip">
         <string>On by default. A workspace menu (Design, Simulation, Manufacture, Drawing; Ctrl+1 to Ctrl+4) and tabs (Solid, Surface, Mesh, Utilities) replace the workbench selector. Opening a sketch adds a SKETCH tab. Off brings back the stock toolbars and selector.</string>
        </property>
        <property name="text">
         <string>Workspaces and tabs</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>WorkspaceBar</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="CommandSearch">
        <property name="toolTip">
         <string>On by default. A search field on the first toolbar row (Cmd-K) finds commands, objects in the document and settings. The SearchBar add-on's toolbar is hidden while it is on.</string>
        </property>
        <property name="text">
         <string>Search field (Cmd-K)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>CommandSearch</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="TabsInTitleBar">
        <property name="toolTip">
         <string>On by default (macOS). The title bar becomes the first toolbar row: traffic lights, save, undo, redo, the document tabs and the search field. Off brings back the title bar and the tab row under the toolbars.</string>
        </property>
        <property name="text">
         <string>Document tabs in the title bar (macOS)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>TabsInTitleBar</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="AutoActivateAssembly">
        <property name="toolTip">
         <string>On by default. When a file becomes the active document and nothing is being edited, its assembly is activated (as a double-click in the tree would), so the joint and assemble tools are ready, and the tree scrolls to it. An assembly active in another open file is let go first. A file with no assembly and exactly one Body gets that body as the active body; with neither, a single Part (an imported part) becomes the active part. Skipped with two or more assemblies, or with several bodies or parts and no assembly, while a sketch, body or dialog is open, and outside the Design workspace.</string>
        </property>
        <property name="text">
         <string>Activate the assembly or body when a file opens</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>AutoActivateAssembly</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="StartPage">
        <property name="toolTip">
         <string>On by default. The Start tab shows the BruceWorx page: New and Open on the left with the vault summary, recent files as cards and as a table with part number, revision and state, and the examples. Off brings back FreeCAD's own Start page.</string>
        </property>
        <property name="text">
         <string>BruceWorx Start page</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>StartPage</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="VaultDashboard">
        <property name="toolTip">
         <string>On by default. With a vault open, the Start page has two tabs: the vault's dashboard (counts by type and state, top assemblies, your work, changes, activity and vault health; every tile opens the filtered Vault panel) and Recent files, the files on this Mac. Off keeps the page as before: My work above the vault's recent files.</string>
        </property>
        <property name="text">
         <string>Vault dashboard on the Start page</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>VaultDashboard</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FollowSystemAppearance">
        <property name="toolTip">
         <string>On by default. Switches between the BruceWorx and BruceWorx Dark values (theme, viewport, view cube, edges) when macOS changes appearance. Uncheck to keep the theme picked on Preferences &gt; General.</string>
        </property>
        <property name="text">
         <string>Follow the macOS light/dark setting</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FollowSystemAppearance</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FollowSystemAccent">
        <property name="toolTip">
         <string>On by default. The accent from System Settings &gt; Appearance colours buttons, checkboxes, selection and the view cube highlight. Text on it turns dark when white would be hard to read.</string>
        </property>
        <property name="text">
         <string>Use the macOS accent colour</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FollowSystemAccent</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layoutSketchGrid">
        <item>
         <widget class="QLabel" name="labelSketchGridStrength">
          <property name="text">
           <string>Sketch grid strength</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefSpinBox" name="SketchGridStrength">
          <property name="toolTip">
           <string>How visible the sketch grid is: white lines on dark, black on light, at this opacity. Open sketches update at once. Python: bruceworx_grid.set_strength(14)</string>
          </property>
          <property name="suffix">
           <string> %</string>
          </property>
          <property name="minimum">
           <number>2</number>
          </property>
          <property name="maximum">
           <number>40</number>
          </property>
          <property name="value">
           <number>10</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>SketchGridStrength</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="spacerSketchGrid">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="SketchGridOnEdit">
        <property name="toolTip">
         <string>FreeCAD saves the grid setting in each sketch. On: every sketch shows the grid when it opens for editing, including sketches made before. The sketch panel can still hide it.</string>
        </property>
        <property name="text">
         <string>Show the grid when a sketch opens</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>SketchGridOnEdit</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="SketchRepair">
        <property name="toolTip">
         <string>When a Pad, Pocket, Revolution or Groove fails on an open sketch, a card at the top of the 3D view shows the open ends (red dots) and offers Close Gaps and Open Sketch. Nothing changes without a click.</string>
        </property>
        <property name="text">
         <string>Offer to close the gaps of an open sketch profile</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>SketchRepair</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layoutSketchRepair">
        <item>
         <widget class="QLabel" name="labelSketchRepairSnap">
          <property name="text">
           <string>Constraint up to</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefDoubleSpinBox" name="SketchRepairSnap">
          <property name="toolTip">
           <string>Ends closer than this get a coincident constraint.</string>
          </property>
          <property name="suffix">
           <string> mm</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="minimum">
           <double>0.001</double>
          </property>
          <property name="maximum">
           <double>10</double>
          </property>
          <property name="singleStep">
           <double>0.05</double>
          </property>
          <property name="value">
           <double>0.1</double>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>SketchRepairSnap</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="labelSketchRepairMaxGap">
          <property name="text">
           <string>short line up to</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefDoubleSpinBox" name="SketchRepairMaxGap">
          <property name="toolTip">
           <string>Ends further apart, up to this, get a short line. Wider gaps are only shown.</string>
          </property>
          <property name="suffix">
           <string> mm</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="minimum">
           <double>0.001</double>
          </property>
          <property name="maximum">
           <double>100</double>
          </property>
          <property name="singleStep">
           <double>0.05</double>
          </property>
          <property name="value">
           <double>1</double>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>SketchRepairMaxGap</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="spacerSketchRepair">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="TrackpadGestures">
        <property name="toolTip">
         <string>Two-finger swipe on a trackpad: a plain swipe pans in any direction (the model follows the fingers), Shift + swipe zooms at the pointer, Cmd + swipe orbits. A mouse wheel and pinch are not affected. Off: a swipe zooms, as in stock FreeCAD.</string>
        </property>
        <property name="text">
         <string>Trackpad: swipe pans, Shift + swipe zooms, Cmd + swipe orbits</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>TrackpadGestures</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="StudioShading">
        <property name="toolTip">
         <string>On by default. Fusion-like studio look in the 3D view: soft lights and studio reflections on every face, each part coloured and finished from its material (aluminium brushed silver, steel darker, ABS ivory, PETG charcoal...). A colour you set by hand is kept. Same switch as BruceWorx &gt; Studio Shading. Off: FreeCAD's own shading, exactly. Drawn while the preference pack is applied.</string>
        </property>
        <property name="text">
         <string>Studio shading (soft lights, reflections, colours from materials)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>StudioShading</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="NavigationPill">
        <property name="toolTip">
         <string>A small bar at the bottom of each 3D view: orbit, pan, zoom (click, then drag in the view; Esc stops), fit all, display style, orthographic/perspective, clipping planes, measure.</string>
        </property>
        <property name="text">
         <string>Navigation pill at the bottom of the 3D view</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>NavigationPill</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layoutNavPillOrbitCenter">
        <item>
         <widget class="QLabel" name="labelNavPillOrbitCenter">
          <property name="text">
           <string>Navigation pill orbits about</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefComboBox" name="NavPillOrbitCenter">
          <property name="toolTip">
           <string>Last clicked point: the point on the model under the pointer where the orbit drag starts (on the focal plane when nothing is there); it also becomes FreeCAD's rotation centre. Point the camera looks at: the centre of the view at the camera's focal distance.</string>
          </property>
          <property name="currentIndex">
           <number>1</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>NavPillOrbitCenter</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
          <item>
           <property name="text">
            <string>Point the camera looks at</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Last clicked point</string>
           </property>
          </item>
         </widget>
        </item>
        <item>
         <spacer name="spacerNavPillOrbitCenter">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="UndoToasts">
        <property name="toolTip">
         <string>A small card above the navigation pill after each command (Pad created, Deleted) with an Undo button; it fades after four seconds. Not shown for property edits or while a sketch is open.</string>
        </property>
        <property name="text">
         <string>Undo toast after each command</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>UndoToasts</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="OnCanvasEditing">
        <property name="toolTip">
         <string>Double-click a face of a Pad, Pocket, Fillet or Hole in the 3D view (or Alt-double-click its Browser row): a drag arrow, a value field and a command bar appear. Drag or type; one drag is one undo step. Esc undoes the edit, Done or a click on empty space leaves.</string>
        </property>
        <property name="text">
         <string>On-canvas editing (double-click a face: drag arrow and value field)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>OnCanvasEditing</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layoutOnCanvasPreview">
        <item>
         <widget class="QLabel" name="labelOnCanvasPreviewMs">
          <property name="text">
           <string>Preview while dragging when a recompute takes over</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefSpinBox" name="OnCanvasPreviewMs">
          <property name="toolTip">
           <string>When recomputes during a drag average more than this, only the edited feature is recomputed and shown see-through; the features after it update when you let go. 0: never.</string>
          </property>
          <property name="suffix">
           <string> ms</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>2000</number>
          </property>
          <property name="singleStep">
           <number>10</number>
          </property>
          <property name="value">
           <number>80</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>OnCanvasPreviewMs</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="spacerOnCanvasPreview">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupMacTitleBar">
     <property name="title">
      <string>macOS window</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutMac">
      <item>
       <widget class="QLabel" name="labelMac">
        <property name="text">
         <string>On by default. Unified title bar and toolbar, with the native close, minimize, and zoom buttons in that bar. Uncheck to restore the stock title bar. macOS only; other systems store the preference and ignore it. Qt 6.8 documents painting problems for this mode when the window contains an OpenGL view (the 3D view) or when toolbars are moved. Confirm that on a Mac.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="UnifiedTitleAndToolBar">
        <property name="toolTip">
         <string>On by default. Calls QMainWindow.setUnifiedTitleAndToolBarOnMac. Uncheck to set that property false, which is Qt stock. Known risk: Qt 6.8 documents painting problems when the window contains an OpenGL view or movable toolbars. Verify on a Mac.</string>
        </property>
        <property name="text">
         <string>Unified title bar and toolbar on macOS</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>UnifiedTitleAndToolBar</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>MainWindow</cstring>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupDocumentTabs">
     <property name="title">
      <string>Document tabs and status bar</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutDocumentTabs">
      <item>
       <layout class="QHBoxLayout" name="layoutDocumentTabPos">
        <item>
         <widget class="QLabel" name="labelDocumentTabPos">
          <property name="text">
           <string>Document tabs</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefComboBox" name="DocumentTabPos">
          <property name="toolTip">
           <string>Where the open files' tabs are: at the bottom of the window (the default), or on top in the title row (macOS). Switches at once.</string>
          </property>
          <property name="currentIndex">
           <number>1</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>DocumentTabPos</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>MainWindow</cstring>
          </property>
          <item>
           <property name="text">
            <string>On top</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>At the bottom</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="CreateVaultInTab">
        <property name="toolTip">
         <string>On by default. Create Vault opens as a full-window tab of its own, with numbered sections and Cancel / Create at the bottom. Off runs it in the task panel on the right.</string>
        </property>
        <property name="text">
         <string>Create Vault in a full-window tab</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>CreateVaultInTab</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="PinStartTab">
        <property name="toolTip">
         <string>On by default. The Start page, where the vault is, stays the first document tab and has no close button, so one click goes back to it.</string>
        </property>
        <property name="text">
         <string>Keep the Start page as the first tab</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>PinStartTab</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="DocumentTabDot">
        <property name="toolTip">
         <string>On by default. A modified document shows a dot on its tab instead of the close button; the close button appears on hover. Unmodified tabs show it on the current tab only.</string>
        </property>
        <property name="text">
         <string>Dot on modified document tabs</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>DocumentTabDot</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="StatusReadouts">
        <property name="toolTip">
         <string>On by default. The status bar reads as text: Report (warnings and errors, click to open the Report view), units, navigation style, view size, and the vault named by BruceWorx/VaultPath.</string>
        </property>
        <property name="text">
         <string>Status bar as text readouts</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>StatusReadouts</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupModelTree">
     <property name="title">
      <string>Floating model tree</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutTree">
      <item>
       <widget class="QLabel" name="labelTree">
        <property name="text">
         <string>On by default. Puts the model tree on the existing left overlay panel (auto-hide, transparency, width, and insets below). Uncheck to write the previous overlay settings back and restore the stock docks. The panel stays pinned to the left edge; a free-floating position needs a later OverlayManager change.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FloatingModelTree">
        <property name="toolTip">
         <string>On by default. Overlay the Model dock (or Tree view, if the panels are split). Uncheck to restore the stock docks.</string>
        </property>
        <property name="text">
         <string>Overlay the model tree</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FloatingModelTree</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FloatingTaskPanel">
        <property name="toolTip">
         <string>On by default. While the model tree floats, the task panel floats on the right as a card that shows while a command is open. Uncheck to dock it again.</string>
        </property>
        <property name="text">
         <string>Float the task panel (command dialog)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FloatingTaskPanel</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserHeader">
        <property name="toolTip">
         <string>On by default. The model tree card is titled BROWSER in small capitals instead of Model.</string>
        </property>
        <property name="text">
         <string>Browser header in small caps</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserHeader</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserBadges">
        <property name="toolTip">
         <string>On by default. A part with the BruceWorx part properties shows its part number and lifecycle state (WIP 02, REV A) after its name; an assembly component shows them as quiet text.</string>
        </property>
        <property name="text">
         <string>Part number and state badges in the Browser</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserBadges</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserSummary">
        <property name="toolTip">
         <string>On by default. Quiet text after a feature's name with its main dimension: Pad 8 mm, R5, Ø9 × 4.</string>
        </property>
        <property name="text">
         <string>Feature summary in the Browser</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserSummary</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserIconPlates">
        <property name="toolTip">
         <string>On by default. In dark mode, a faint light plate behind each tree icon keeps dark-outlined icons readable.</string>
        </property>
        <property name="text">
         <string>Icon plates in the Browser (dark mode)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserIconPlates</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserGroupCaptions">
        <property name="toolTip">
         <string>On by default. Property groups are small-caps captions instead of grey bars (BruceWorx theme).</string>
        </property>
        <property name="text">
         <string>Quiet property group captions</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserGroupCaptions</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="PickTrace">
        <property name="toolTip">
         <string>Picking a face, edge or vertex in the 3D view highlights the feature that made it in the Browser and on the history timeline. The selection is not changed.</string>
        </property>
        <property name="text">
         <string>Pick a face: show the feature that made it</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>PickTrace</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="AssemblyPick">
        <property name="toolTip">
         <string>On by default. In an assembly, a pick in the 3D view selects the component directly under the open assembly (its vault file), not the body inside it. Pick inside it again to go one level deeper each time, down to the face; pick elsewhere to start at the top again. Option-click picks the face at once. Tree clicks, and picks while a task panel such as a joint is open, are left alone.</string>
        </property>
        <property name="text">
         <string>Assembly pick: select the component first</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>AssemblyPick</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserErrorChips">
        <property name="toolTip">
         <string>A feature whose recompute failed gets a red ERROR chip in the Browser; click it to open the feature.</string>
        </property>
        <property name="text">
         <string>Error chip on failed features</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserErrorChips</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="BrowserDependencyLines">
        <property name="toolTip">
         <string>Hovering a Browser row draws thin lines to the rows it uses (Sketch to Pad) and the rows that use it.</string>
        </property>
        <property name="text">
         <string>Dependency lines on hover</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>BrowserDependencyLines</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="RightPanelTabs">
        <property name="toolTip">
         <string>Properties, Vault, Parameters and Physical as tabs of the right panel; a command opens as a tab of its own. Cmd-I hides and shows the panel. Takes effect after a restart.</string>
        </property>
        <property name="text">
         <string>Right panel tabs: Properties, Vault, Parameters, Physical</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>RightPanelTabs</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="ShowTaskWatcher">
        <property name="toolTip">
         <string>The BruceWorx pack turns this off. FreeCAD's task watchers: the workbench's command lists (such as Insert, Constraints, Exploded View) shown in the task panel. They repeat the toolbar.</string>
        </property>
        <property name="text">
         <string>Show workbench command lists in the task panel</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
