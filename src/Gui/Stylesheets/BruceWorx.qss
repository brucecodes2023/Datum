/*
BruceWorx
============================================================================================================
Clean but feature dense chrome for FreeCAD 1.1 (roadmap §13.3). Colors come from the theme
parameter file selected by Preferences/MainWindow/Theme:

    Gui/Stylesheets/parameters/BruceWorx.yaml        (light)
    Gui/Stylesheets/parameters/BruceWorx Dark.yaml   (dark)

@AccentColor is Themes/ThemeAccentColor1, which BruceWorx keeps on the macOS accent; @AccentTextColor
and @AccentGlyphColor (white or near-black, by contrast) live in Themes/UserParameters and are written
by bruceworx_appearance.py.

One sheet, both themes. Sizes live here and sit on a 4 px grid: 12 px text, 10-11 px captions, 22 px
tree rows, 24 px toolbar icons in 32 px buttons, 6 px control corners, 10 px card corners. The yaml
files only change color tokens, so light and dark stay in step.

Tree and list items get vertical padding only. Horizontal item padding makes FreeCAD's tree
delegate elide labels ("Ass...bly") even when the column is wide enough.

The sheet is applied by the BruceWorx preference pack. It does not replace FreeCAD's default until
that pack is applied.
============================================================================================================
*/

/* Type and color on the shells we actually paint. A global QWidget rule is
   avoided: FreeCAD.qss notes that it slows startup. */
QMainWindow,
QDialog,
QDockWidget,
QMenu,
QMenuBar,
QToolBar,
QStatusBar,
QToolTip {
  font-family: ".AppleSystemUIFont", "SF Pro Text", "Helvetica Neue", "Segoe UI", "Noto Sans", sans-serif;
  font-size: 12px;
  color: @TextForegroundColor;
}

QMainWindow,
QDialog {
  background-color: @GeneralBackgroundColor;
}

QMainWindow::separator {
  background: @GeneralBorderColor;
  width: 1px;
  height: 1px;
}

/* Menus ------------------------------------------------------------------------------------------ */
QMenuBar {
  background-color: @ChromeColor;
  border-bottom: 1px solid @GeneralBorderColor;
  padding: 2px 8px;
  spacing: 2px;
}

QMenuBar::item {
  background: transparent;
  padding: 4px 10px;
  border-radius: 6px;
}

QMenuBar::item:selected {
  background-color: @HoverColor;
}

QMenuBar::item:pressed {
  background-color: @AccentColor;
  color: @AccentTextColor;
}

QMenu {
  background-color: @MenuBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 8px;
  padding: 4px;
}

QMenu::item {
  padding: 4px 24px 4px 12px;
  border-radius: 5px;
  margin: 0px 2px;
}

QMenu::item:selected {
  background-color: @AccentColor;
  color: @AccentTextColor;
}

QMenu::item:disabled {
  color: @TextDisabledColor;
}

QMenu::separator {
  height: 1px;
  background: @GeneralBorderColor;
  margin: 4px 8px;
}

/* Toolbars --------------------------------------------------------------------------------------- */
QToolBar {
  background-color: @GeneralBackgroundColor;
  border: none;
  spacing: 2px;
  padding: 4px 6px;
}

QToolBar::separator {
  background: @GeneralBorderColor;
  width: 1px;
  margin: 4px 6px;
}

QToolBar::handle {
  width: 0px;
  height: 0px;
}

QToolButton {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: @ToolbarButtonsPadding;
  margin: 0px;
}

/* The icon plate: invisible in light, a faint light square in dark. */
QToolBar QToolButton {
  background-color: @IconPlateColor;
}

QToolButton:hover,
QToolBar QToolButton:hover {
  background-color: @HoverColor;
}

QToolButton:pressed,
QToolButton:checked,
QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
  background-color: @AccentSoftColor;
  border-color: @AccentColor;
}

/* Captioned tool groups (BruceWorx step C1): a divider after each group, a caption under it. */
QToolBar[bwGroup="true"] {
  border-right: 1px solid @GeneralBorderColor;
}

QToolButton#BruceWorxGroupCaption {
  background-color: transparent;
  border: none;
  padding: 0px 4px;
  margin: 0px;
  font-size: 10px;
  font-weight: 600;
  color: @TextSecondaryColor;
}

QToolButton#BruceWorxGroupCaption:hover {
  background-color: transparent;
  border: none;
  color: @TextForegroundColor;
}

QToolButton#BruceWorxGroupCaption:open,
QToolButton#BruceWorxGroupCaption:pressed {
  background-color: transparent;
  border: none;
  color: @AccentColor;
}

QLabel#BruceWorxGroupCaptionMenuTitle {
  color: @TextSecondaryColor;
  font-size: 10px;
  font-weight: 600;
  padding: 6px 12px 2px 12px;
}

QToolButton#BruceWorxGroupCaption::menu-indicator {
  image: none;
  width: 0px;
}

QToolButton:disabled {
  color: @TextDisabledColor;
}

/* Drop-down tools. Without these Qt paints the menu part as a black bar. */
QToolButton[popupMode="1"] {
  padding-right: 14px;
}

QToolButton::menu-button {
  border: none;
  width: 12px;
  border-top-right-radius: 6px;
  border-bottom-right-radius: 6px;
}

QToolButton::menu-button:hover {
  background-color: @HoverColor;
}

QToolButton::menu-indicator {
  image: none;
  width: 0px;
}

QToolButton::menu-arrow {
  image: url(qss:images_classic/arrow-down-@GlyphColor.svg);
  width: 8px;
  height: 8px;
}

QToolButton::menu-arrow:open,
QToolButton::menu-arrow:hover {
  image: url(qss:images_classic/arrow-down-@GlyphStrongColor.svg);
}

/* Workbench tabs: caption-style labels with an accent underline. */
#WbTabBar QTabBar {
  background: transparent;
}

#WbTabBar QTabBar::tab {
  background: transparent;
  color: @TextSecondaryColor;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  padding: 4px 10px;
  margin: 0px 2px;
  font-size: 11px;
  font-weight: 600;
  min-height: 18px;
}

#WbTabBar QTabBar::tab:selected {
  color: @TextForegroundColor;
  border-bottom-color: @AccentColor;
}

#WbTabBar QTabBar::tab:hover:!selected {
  color: @TextForegroundColor;
}

/* Workspace bar (BruceWorx step C2): the workspace button, its tabs and Finish Sketch. */
QToolBar#BruceWorxWorkspaces {
  padding: 2px 8px 0px 8px;
  spacing: 12px;
}

QToolButton#BruceWorxWorkspaceButton {
  background-color: @CardBackgroundColor;
  color: @TextForegroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 700;
}

QToolButton#BruceWorxWorkspaceButton:hover {
  background-color: @HoverColor;
}

QToolButton#BruceWorxWorkspaceButton::menu-indicator {
  image: none;
  width: 0px;
}

QTabBar#BruceWorxWorkspaceTabs {
  background: transparent;
}

QTabBar#BruceWorxWorkspaceTabs::tab {
  background: transparent;
  color: @TextSecondaryColor;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  padding: 5px 12px;
  margin: 0px 2px;
  font-size: 12px;
  font-weight: 600;
  min-height: 18px;
}

QTabBar#BruceWorxWorkspaceTabs::tab:selected {
  color: @TextForegroundColor;
  border-bottom-color: @AccentColor;
}

QTabBar#BruceWorxWorkspaceTabs::tab:hover:!selected {
  color: @TextForegroundColor;
}

/* The contextual SKETCH tab is always the last one. */
QTabBar#BruceWorxWorkspaceTabs[sketch="true"]::tab:last {
  color: @AccentColor;
  border-bottom-color: @AccentColor;
}

QToolButton#BruceWorxFinishSketch {
  background-color: @AccentColor;
  color: @AccentTextColor;
  border: none;
  border-radius: 6px;
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 700;
}

QToolButton#BruceWorxFinishSketch:hover {
  background-color: @AccentHoverColor;
  color: @AccentColor;
}

/* Search (BruceWorx step C3): the Cmd-K field and its results. */
QLineEdit#BruceWorxSearch {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 7px;
  padding: 3px 8px;
  min-height: 20px;
}

QLineEdit#BruceWorxSearch:focus {
  border-color: @AccentColor;
}

QLabel#BruceWorxSearchHint {
  color: @TextSecondaryColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 4px;
  padding: 0px 4px;
  font-size: 10px;
}

QFrame#BruceWorxSearchResults {
  background-color: @MenuBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

QListWidget#BruceWorxSearchList {
  background: transparent;
  border: none;
  outline: none;
}

QListWidget#BruceWorxSearchList::item {
  padding: 4px 6px;
  border-radius: 6px;
}

QListWidget#BruceWorxSearchList::item:disabled {
  color: @TextSecondaryColor;
  padding-top: 8px;
}

QListWidget#BruceWorxSearchList::item:selected {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
}

/* Cmd-Return in search flashes the command's button or group caption. */
QToolButton[bwFlash="true"] {
  background-color: @AccentSoftColor;
  border-color: @AccentColor;
}

/* Search (BruceWorx step C3): the Cmd-K field and its results. */
QLineEdit#BruceWorxSearch {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 7px;
  padding: 3px 8px;
  min-height: 20px;
}

QLineEdit#BruceWorxSearch:focus {
  border-color: @AccentColor;
}

QLabel#BruceWorxSearchHint {
  color: @TextSecondaryColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 4px;
  padding: 0px 4px;
  font-size: 10px;
}

QFrame#BruceWorxSearchResults {
  background-color: @MenuBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

QListWidget#BruceWorxSearchList {
  background: transparent;
  border: none;
  outline: none;
}

QListWidget#BruceWorxSearchList::item {
  padding: 4px 6px;
  border-radius: 6px;
}

QListWidget#BruceWorxSearchList::item:disabled {
  color: @TextSecondaryColor;
  padding-top: 8px;
}

QListWidget#BruceWorxSearchList::item:selected {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
}

/* Cmd-Return in search flashes the command's button or group caption. */
QToolButton[bwFlash="true"] {
  background-color: @AccentSoftColor;
  border-color: @AccentColor;
}

/* Title row (BruceWorx step C4, macOS): the title bar as the first toolbar row, with the
   document tabs. The tabs look like the step B tabs on top. */
QToolBar#BruceWorxTitleRow {
  background-color: @ChromeColor;
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
  padding: 0px 8px 0px 0px;
  spacing: 4px;
}

QTabBar#BruceWorxTitleTabs {
  background: transparent;
}

QTabBar#BruceWorxTitleTabs::tab {
  background: transparent;
  color: @TextSecondaryColor;
  border: 1px solid transparent;
  border-radius: 7px;
  padding: 4px 8px 4px 10px;
  margin: 5px 1px;
  min-width: 100px;
  max-width: 200px;
}

QTabBar#BruceWorxTitleTabs::tab:selected {
  background: @GeneralBackgroundColor;
  color: @TextForegroundColor;
  border-color: @GeneralBorderColor;
}

QTabBar#BruceWorxTitleTabs::tab:hover:!selected {
  color: @TextForegroundColor;
}

QToolButton#BruceWorxNewTab {
  background: transparent;
  color: @TextSecondaryColor;
  border: none;
  font-size: 16px;
  padding: 0px 6px;
}

QToolButton#BruceWorxNewTab:hover {
  color: @TextForegroundColor;
  background-color: @HoverColor;
}

/* Docks ------------------------------------------------------------------------------------------ */
QDockWidget {
  background-color: @GeneralBackgroundColor;
  titlebar-close-icon: url(qss:images_classic/close-@GlyphColor.svg);
  titlebar-normal-icon: url(qss:images_classic/float-@GlyphColor.svg);
}

QDockWidget::title {
  background-color: @GeneralBackgroundColor;
  color: @TextSecondaryColor;
  padding: 4px 8px;
  text-align: left;
  border-bottom: 1px solid @GeneralBorderColor;
}

QDockWidget::close-button,
QDockWidget::float-button {
  border: none;
  background: transparent;
  padding: 0px;
  icon-size: 10px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
  background: @HoverColor;
  border-radius: 4px;
}

/* Tabs: tab widgets inside panels and dialogs --------------------------------------------------- */
QTabWidget::pane {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 8px;
  top: -1px;
}

QTabBar::tab {
  background-color: @InActiveTabBackgroundColor;
  color: @TextSecondaryColor;
  border: 1px solid transparent;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  padding: 4px 10px;
  margin-right: 2px;
  min-height: 16px;
}

QTabBar::tab:selected {
  background-color: @ActiveTabBackgroundColor;
  color: @TextForegroundColor;
  border-color: @GeneralBorderColor;
  border-bottom-color: @ActiveTabBackgroundColor;
}

QTabBar::tab:hover:!selected {
  color: @TextForegroundColor;
}

QTabBar::close-button {
  image: url(qss:images_classic/close-thin-@CloseGlyphColor.svg);
  subcontrol-position: right;
  width: 8px;
  height: 8px;
  padding: 3px;
  border-radius: 4px;
}

QTabBar::close-button:hover {
  image: url(qss:images_classic/close-thin-@CloseGlyphStrongColor.svg);
  background: @HoverColor;
}

/* Document tabs (the MDI area) */
QMdiArea QTabBar {
  background: @ChromeColor;
}

QMdiArea QTabBar::tab {
  background: transparent;
  color: @TextSecondaryColor;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 3px 8px;
  margin: 3px 2px;
  min-width: 90px;
}

QMdiArea QTabBar::tab:selected {
  background: @GeneralBackgroundColor;
  color: @TextForegroundColor;
  border-color: @GeneralBorderColor;
}

/* On top (MainWindow/DocumentTabPos, set by the pack) they read as the mock's title-bar tabs:
   rounded top corners, the current tab open towards the view. */
QMdiArea QTabBar::tab:top {
  border-radius: 0px;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
  border-bottom: none;
  padding: 5px 8px 5px 10px;
  margin: 4px 1px 0px 1px;
  min-width: 100px;
  max-width: 200px;
}

QMdiArea QTabBar::tab:hover:!selected {
  color: @TextForegroundColor;
}

/* Tab close button ([BW] MainWindow.cpp, BruceWorx/DocumentTabDot): a dot while the document is
   modified, a thin x on hover. It paints in its text colour. */
#documentTabButton {
  color: @TextSecondaryColor;
  background: transparent;
  border: none;
  border-radius: 4px;
}

#documentTabButton:hover {
  color: @TextForegroundColor;
  background: @HoverColor;
}

/* Trees, lists, property editor ------------------------------------------------------------------ */
QTreeView,
QListView,
QTableView,
QTreeWidget,
QListWidget {
  background-color: @CardBackgroundColor;
  alternate-background-color: @CardBackgroundColor;
  color: @TextForegroundColor;
  border: none;
  outline: none;
  gridline-color: @GeneralGridLinesColor;
  selection-background-color: @AccentSoftColor;
  selection-color: @TextForegroundColor;
}

QTreeView::item,
QListView::item,
QTreeWidget::item,
QListWidget::item {
  padding-top: 3px;
  padding-bottom: 3px;
  border: none;
}

QTreeView::item:hover,
QListView::item:hover,
QTreeWidget::item:hover,
QListWidget::item:hover {
  background-color: @HoverColor;
}

QTreeView::item:selected,
QListView::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
}

QTreeView::branch:closed:has-children {
  image: url(qss:images_classic/arrow-right-@GlyphColor.svg);
  padding: 5px;
}

QTreeView::branch:open:has-children {
  image: url(qss:images_classic/arrow-down-@GlyphColor.svg);
  padding: 5px;
}

QHeaderView::section {
  background-color: @CardBackgroundColor;
  color: @TextSecondaryColor;
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
  padding: 4px 8px;
  font-size: 11px;
  font-weight: 600;
}

Gui--PropertyEditor--PropertyEditor {
  background-color: @CardBackgroundColor;
  color: @TextForegroundColor;
  qproperty-groupTextColor: @TextSecondaryColor;
  qproperty-groupBackground: @CardBackgroundColor;
}

/* Browser (bruceworx_browser.py, [BW] in Tree.cpp and PropertyItemDelegate.cpp): summary text and
   P/N / state badges after a tree row's name; property groups as quiet small-caps captions. */
Gui--TreeWidget {
  qproperty-rowMetaColor: @TextDisabledColor;
  qproperty-badgeBackground: @HoverColor;
  qproperty-badgeTextColor: @TextSecondaryColor;
  qproperty-badgeWarnColor: @WarnColor;
  qproperty-badgeAccentColor: @AccentColor;
  qproperty-badgeErrorColor: @ErrorColor;
}

Gui--PropertyEditor--PropertyEditor {
  qproperty-quietGroupCaptions: 1;
  qproperty-groupTextColor: @TextDisabledColor;
}

/* Buttons and fields ----------------------------------------------------------------------------- */
QPushButton {
  background-color: @ButtonTopBackgroundColor;
  color: @TextForegroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  padding: 3px 12px;
  min-height: 16px;
}

QPushButton:hover {
  border-color: @TextDisabledColor;
}

QPushButton:pressed,
QPushButton:checked,
QPushButton:default {
  background-color: @AccentColor;
  color: @AccentTextColor;
  border-color: @AccentColor;
}

QPushButton:disabled {
  background-color: @GeneralDisabledBackgroundColor;
  color: @TextDisabledColor;
  border-color: @GeneralBorderColor;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QAbstractSpinBox,
QTextEdit,
QPlainTextEdit {
  background-color: @TextEditFieldBackgroundColor;
  color: @TextForegroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: @InputFieldBorderRadius;
  padding: 2px 6px;
  min-height: 18px;
  selection-background-color: @AccentSoftColor;
  selection-color: @TextForegroundColor;
}

QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
  border: 1px solid @AccentColor;
}

QLineEdit:disabled,
QComboBox:disabled,
QAbstractSpinBox:disabled {
  color: @TextDisabledColor;
  background-color: @GeneralDisabledBackgroundColor;
}

QComboBox::drop-down {
  border: none;
  width: 18px;
}

QComboBox::down-arrow {
  image: url(qss:images_classic/arrow-down-@GlyphColor.svg);
  width: 8px;
  height: 8px;
}

QComboBox QAbstractItemView {
  background-color: @MenuBackgroundColor;
  color: @TextForegroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  selection-background-color: @AccentColor;
  selection-color: @AccentTextColor;
  padding: 2px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
  border: none;
  width: 14px;
}

QAbstractSpinBox::up-arrow {
  image: url(qss:images_classic/arrow-up-@GlyphColor.svg);
  width: 7px;
  height: 7px;
}

QAbstractSpinBox::down-arrow {
  image: url(qss:images_classic/arrow-down-@GlyphColor.svg);
  width: 7px;
  height: 7px;
}

QCheckBox,
QRadioButton {
  spacing: 6px;
  color: @TextForegroundColor;
  background: transparent;
}

QCheckBox::indicator,
QGroupBox::indicator,
QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid @CheckBoxBorderColor;
  background-color: @CheckBoxBackgroundColor;
}

QCheckBox::indicator,
QGroupBox::indicator {
  border-radius: 4px;
}

QRadioButton::indicator {
  border-radius: 8px;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
  background-color: @AccentColor;
  border-color: @AccentColor;
  image: url(qss:images_classic/check-mark-@AccentGlyphColor.svg);
}

QCheckBox::indicator:indeterminate {
  background-color: @AccentColor;
  border-color: @AccentColor;
  image: url(qss:images_classic/indeterminate-mark-@AccentGlyphColor.svg);
}

QRadioButton::indicator:checked {
  background-color: @AccentColor;
  border-color: @AccentColor;
  image: url(qss:images_classic/radio-mark-@AccentGlyphColor.svg);
}

/* Check boxes inside lists, trees and tables: the same box (the default is faint in dark). */
QAbstractItemView::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid @CheckBoxBorderColor;
  border-radius: 4px;
  background-color: @CheckBoxBackgroundColor;
}

QAbstractItemView::indicator:checked {
  background-color: @AccentColor;
  border-color: @AccentColor;
  image: url(qss:images_classic/check-mark-@AccentGlyphColor.svg);
}

QAbstractItemView::indicator:indeterminate {
  background-color: @AccentColor;
  border-color: @AccentColor;
  image: url(qss:images_classic/indeterminate-mark-@AccentGlyphColor.svg);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QRadioButton::indicator:disabled {
  background-color: @GeneralDisabledBackgroundColor;
  border-color: @GeneralBorderColor;
}

/* Group boxes read as sections of a card: a hairline and a small caption. */
QGroupBox {
  background-color: transparent;
  border: none;
  border-top: 1px solid @GeneralBorderColor;
  border-radius: 0px;
  margin-top: 18px;
  padding: 6px 0px 0px 0px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 0px;
  padding: 0px 0px 2px 0px;
  color: @TextSecondaryColor;
  font-size: 11px;
  font-weight: 600;
}

/* A section that can be switched on (Direction 2) shows a real checkbox and a text-coloured caption. */
QGroupBox[checkable="true"]::title {
  left: 3px;
  color: @TextForegroundColor;
}

QGroupBox::indicator {
  margin-right: 6px;
}

/* Task panel: one card per box, flat header ------------------------------------------------------ */
Gui--TaskView--TaskView,
Gui--TaskView--TaskView > QWidget > QWidget {
  background-color: @GeneralBackgroundColor;
  border: none;
}

QSint--ActionGroup {
  border-radius: 10px;
}

QSint--ActionGroup QFrame[class="header"] {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-bottom: none;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  border-bottom-left-radius: 0px;
  border-bottom-right-radius: 0px;
  padding: 2px 4px;
}

QSint--ActionGroup QToolButton[class="header"] {
  background: transparent;
  text-align: left;
  font-weight: 600;
  border: none;
  color: @TextForegroundColor;
}

QSint--ActionGroup QFrame[class="header"] QLabel[fold="false"] {
  image: url(qss:images_classic/arrow-down-@GlyphColor.svg);
  padding: 4px;
}

QSint--ActionGroup QFrame[class="header"] QLabel[fold="true"] {
  image: url(qss:images_classic/arrow-right-@GlyphColor.svg);
  padding: 4px;
}

QSint--ActionGroup QFrame[class="content"] {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-top: 1px solid @GeneralGridLinesColor;
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  border-bottom-left-radius: 10px;
  border-bottom-right-radius: 10px;
  padding: 4px 6px;
}

QSint--ActionGroup QFrame[class="content"] QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 3px 4px;
  text-align: left;
}

QSint--ActionGroup QFrame[class="content"] QToolButton:hover {
  background: @HoverColor;
}

QSint--ActionGroup QFrame[class="content"] QToolButton:checked {
  background: @AccentSoftColor;
  border-color: @AccentColor;
}

/* Scrollbars ------------------------------------------------------------------------------------- */
QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 2px;
}

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
  background: @ScrollbarBackgroundColor;
  border-radius: 3px;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:hover {
  background: @TextDisabledColor;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
  background: transparent;
  border: none;
  height: 0;
  width: 0;
}

/* Status bar: quiet readouts --------------------------------------------------------------------- */
QStatusBar {
  background-color: @ChromeColor;
  border-top: 1px solid @GeneralBorderColor;
  color: @TextSecondaryColor;
  padding: 0px 6px;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  background: transparent;
  color: @TextSecondaryColor;
  padding: 0px 6px;
}

QStatusBar QPushButton,
QStatusBar QToolButton {
  background: transparent;
  color: @TextSecondaryColor;
  border: none;
  border-radius: 4px;
  padding: 1px 6px;
  min-height: 14px;
}

QStatusBar QPushButton:hover,
QStatusBar QToolButton:hover {
  background: @HoverColor;
  color: @TextForegroundColor;
}

QStatusBar QPushButton::menu-indicator {
  image: none;
  width: 0px;
}

/* Readouts (BruceWorx/StatusReadouts, [BW] MainWindow.cpp and bruceworx_statusbar.py): Report, units,
   navigation, view size and vault as plain text. Colour only for state. */
QStatusBar QPushButton#reportReadout[level="warning"] {
  color: @WarnColor;
}

QStatusBar QPushButton#reportReadout[level="error"] {
  color: @ErrorColor;
}

QStatusBar QLabel#vaultReadout {
  color: @OkColor;
}

/* Claude Code bridge (bruceworx_bridge.py): shown while Claude Code may control FreeCAD; a click disconnects. */
QStatusBar QPushButton#claudeChip {
  background-color: @AccentSoftColor;
  color: @AccentColor;
  border-radius: 8px;
  padding: 1px 8px;
}

QStatusBar QPushButton#claudeChip:hover {
  background-color: @AccentColor;
  color: @AccentTextColor;
}

/* Toolbars placed in the status bar: no plate of their own. */
QStatusBar QToolBar,
QStatusBar QToolBar QToolButton {
  background: transparent;
  border: none;
  padding: 0px;
}

/* Tooltips and labels ---------------------------------------------------------------------------- */
QToolTip {
  background-color: @MenuBackgroundColor;
  color: @TextForegroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  padding: 4px 6px;
}

QLabel {
  background: transparent;
  color: @TextForegroundColor;
}

/* The notification popup is a top-level QLabel; the rule above would make it see-through. */
QLabel#NotificationBox_label {
  background-color: @MenuBackgroundColor;
  border: 1px solid @GeneralBorderColor;
}

QLabel[link="true"],
a {
  color: @TextUrlColor;
}

/* History timeline (BruceWorx mod): one quiet row of icon chips --------------------------------- */
QWidget#HistoryTimelineBar,
QWidget#HistoryTimelineRow,
QScrollArea#HistoryTimelineScroll {
  background-color: @GeneralBackgroundColor;
  border: none;
}

QWidget#HistoryTimelineBar {
  border-top: 1px solid @GeneralBorderColor;
}

QLabel#HistoryTimelineTitle {
  color: @TextSecondaryColor;
  font-size: 11px;
  font-weight: 600;
  padding-right: 4px;
}

QLabel#HistoryTimelineHint {
  color: @TextDisabledColor;
  padding: 0px 6px;
}

/* The chips paint themselves from these palette colors. */
QWidget[historyChip="true"] {
  background-color: @IconPlateColor;
  alternate-background-color: @GeneralBackgroundColor;
  selection-background-color: @AccentSoftColor;
  selection-color: @AccentColor;
}

/* Start page ------------------------------------------------------------------------------------- */
QWidget#StartView,
QWidget#StartView QScrollArea,
QWidget#StartView QScrollArea > QWidget > QWidget,
QWidget#StartView QStackedWidget > QWidget {
  background-color: @GeneralBackgroundColor;
  border: none;
}

QWidget#StartView QListView {
  background-color: transparent;
}

QWidget#StartView QLabel {
  color: @TextForegroundColor;
}

QPushButton#newFileButton {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
  text-align: left;
}

QPushButton#newFileButton:hover {
  border-color: @AccentColor;
}

QWidget#thumbnailWidget {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

QWidget#thumbnailWidget[state="hovered"],
QWidget#thumbnailWidget[state="pressed"] {
  border-color: @AccentColor;
}

/* BruceWorx Start page (bruceworx_start.py, step C5): New / Open / vault on the left, recent files
   as cards and a table on the right. The page is the third page of StartView's stack. */
#BruceWorxStart,
#BruceWorxStart QScrollArea#bwStartScroll,
#BruceWorxStart QWidget#bwStartMain {
  background-color: @GeneralBackgroundColor;
  border: none;
}

#BruceWorxStart QFrame#bwStartSide {
  background-color: @GeneralBackgroundColor;
  border: none;
  border-right: 1px solid @GeneralBorderColor;
}

#BruceWorxStart QLabel#bwStartCaption {
  color: @TextDisabledColor;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.7px;
  padding: 0px 4px 4px 4px;
}

#BruceWorxStart QLabel#bwStartTitle {
  font-size: 17px;
  font-weight: 700;
}

#BruceWorxStart QLabel#bwStartMuted,
#BruceWorxStart QLabel#bwStartKey {
  color: @TextSecondaryColor;
}

#BruceWorxStart QLabel#bwStartKey {
  color: @TextDisabledColor;
  font-size: 11px;
}

#BruceWorxStart QPushButton#bwStartItem {
  background-color: transparent;
  border: none;
  border-radius: 7px;
  padding: 0px 8px;
  min-height: 32px;
  max-height: 32px;
  text-align: left;
  color: @TextForegroundColor;
}

#BruceWorxStart QPushButton#bwStartItem:hover {
  background-color: @HoverColor;
}

#BruceWorxStart QPushButton#bwStartItem:pressed {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
}

#BruceWorxStart QPushButton#bwStartLink {
  background-color: transparent;
  border: none;
  padding: 0px;
  min-height: 0px;
  color: @AccentColor;
}

#BruceWorxStart QPushButton#bwStartLink:hover {
  text-decoration: underline;
}

#BruceWorxStart QPushButton#bwStartLink:pressed {
  background-color: transparent;
  color: @AccentColor;
}

/* The Start page's one-line vault switcher (PDM-04): the vault's name with a menu. */
#BruceWorxStart QToolButton#bwStartVaultSwitch {
  background: transparent;
  color: @TextForegroundColor;
  border: none;
  border-radius: 6px;
  padding: 5px 6px;
  font-size: 13px;
  font-weight: 600;
  text-align: left;
}

#BruceWorxStart QToolButton#bwStartVaultSwitch:hover {
  background-color: @HoverColor;
}

#BruceWorxStart QToolButton#bwStartVaultSwitch::menu-indicator {
  image: none;
  width: 0px;
}

#BruceWorxStart QFrame#bwStartVault {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 9px;
}

#BruceWorxStart QLabel#bwStartVaultName,
#BruceWorxStart QLabel#bwStartVaultCount {
  font-weight: 600;
}

#BruceWorxStart QLabel#bwStartWarn {
  color: @WarnColor;
}

/* Segmented filter: All / Parts / Assemblies / Drawings */
#BruceWorxStart QFrame#bwStartSegments {
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  background-color: @CardBackgroundColor;
}

#BruceWorxStart QPushButton#bwStartSegment {
  background-color: transparent;
  border: none;
  border-left: 1px solid @GeneralBorderColor;
  border-radius: 0px;
  padding: 0px 8px;
  min-height: 22px;
  max-height: 22px;
  color: @TextSecondaryColor;
}

#BruceWorxStart QPushButton#bwStartSegment[position="first"] {
  border-left: none;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
}

#BruceWorxStart QPushButton#bwStartSegment[position="last"] {
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
}

#BruceWorxStart QPushButton#bwStartSegment:hover {
  background-color: @HoverColor;
}

#BruceWorxStart QPushButton#bwStartSegment:checked {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
  font-weight: 600;
}

#BruceWorxStart QLineEdit#bwStartFilter {
  min-height: 22px;
}

/* Cards */
#BruceWorxStart QFrame#bwStartCard {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

#BruceWorxStart QFrame#bwStartCard:hover {
  border-color: @AccentColor;
}

#BruceWorxStart QLabel#bwStartThumb {
  background-color: @CardBackgroundColor;
  border: none;
  border-top-left-radius: 9px;
  border-top-right-radius: 9px;
}

#BruceWorxStart QWidget#bwStartCardInfo {
  background-color: transparent;
}

#BruceWorxStart QLabel#bwStartCardName {
  font-weight: 600;
  color: @TextForegroundColor;
}

#BruceWorxStart QFrame#bwStartCard QLabel:disabled {
  color: @TextDisabledColor;
}

/* Lifecycle state badges: the state colour as text and outline. */
#BruceWorxStart QLabel#bwStartBadge {
  font-size: 9px;
  font-weight: 700;
  padding: 0px 4px;
  border: 1px solid @GeneralBorderColor;
  border-radius: 4px;
  color: @TextSecondaryColor;
  background-color: transparent;
}

#BruceWorxStart QLabel#bwStartBadge[state="wip"] {
  color: @WarnColor;
  border-color: @WarnColor;
}

#BruceWorxStart QLabel#bwStartBadge[state="rel"] {
  color: @OkColor;
  border-color: @OkColor;
}

#BruceWorxStart QLabel#bwStartBadge[state="rev"] {
  color: @AccentColor;
  border-color: @AccentColor;
  background-color: @AccentSoftColor;
}

/* Table */
#BruceWorxStart QTreeWidget#bwStartTable {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
  padding: 0px;
}

#BruceWorxStart QTreeWidget#bwStartTable QHeaderView::section {
  background-color: @HoverColor;
  color: @TextDisabledColor;
  font-size: 10px;
  font-weight: 700;
  padding: 5px 8px;
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
}

#BruceWorxStart QTreeWidget#bwStartTable QHeaderView::section:first {
  border-top-left-radius: 9px;
}

#BruceWorxStart QTreeWidget#bwStartTable QHeaderView::section:last {
  border-top-right-radius: 9px;
}

#BruceWorxStart QTreeWidget#bwStartTable::item {
  padding: 0px 4px;
  border: none;
  border-bottom: 1px solid @GeneralGridLinesColor;
}

#BruceWorxStart QTreeWidget#bwStartTable::item:disabled {
  color: @TextDisabledColor;
}

#BruceWorxStart QWidget#bwStartCell {
  background-color: transparent;
}

/* Vault dashboard on the Start page (bruceworx_dashboard.py, PDM-10): tabs, header, tiles and cards. */
#BruceWorxStart QPushButton#bwStartTab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  padding: 4px 0px 6px 0px;
  min-height: 22px;
  color: @TextSecondaryColor;
  font-size: 13px;
  font-weight: 600;
}

#BruceWorxStart QPushButton#bwStartTab:hover {
  color: @TextForegroundColor;
}

#BruceWorxStart QPushButton#bwStartTab:checked {
  color: @TextForegroundColor;
  border-bottom-color: @AccentColor;
}

#BruceWorxStart QFrame#bwStartTabs {
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
}

#BruceWorxStart QWidget#bwDashColours {
  qproperty-wipColor: @WarnColor;
  qproperty-reviewColor: @AccentColor;
  qproperty-releasedColor: @OkColor;
  qproperty-obsoleteColor: @TextDisabledColor;
  qproperty-trackColor: @GeneralGridLinesColor;
  qproperty-accentColor: @AccentColor;
  qproperty-secondaryColor: @TextSecondaryColor;
  qproperty-okColor: @OkColor;
  qproperty-warnColor: @WarnColor;
  qproperty-errorColor: @ErrorColor;
  qproperty-barColor: @AccentColor;
}

#BruceWorxStart QLabel#bwDashName {
  font-size: 22px;
  font-weight: 700;
}

#BruceWorxStart QLabel#bwDashSync,
#BruceWorxStart QLabel#bwDashCount,
#BruceWorxStart QLabel#bwDashRowSub,
#BruceWorxStart QLabel#bwDashTime,
#BruceWorxStart QLabel#bwDashNote,
#BruceWorxStart QLabel#bwDashChevron {
  color: @TextSecondaryColor;
}

#BruceWorxStart QPushButton#bwDashButton,
#BruceWorxStart QPushButton#bwDashPrimary {
  border: 1px solid @GeneralBorderColor;
  border-radius: 7px;
  padding: 4px 14px;
  min-height: 22px;
  background-color: @CardBackgroundColor;
  color: @TextForegroundColor;
}

#BruceWorxStart QPushButton#bwDashButton:hover {
  background-color: @HoverColor;
}

#BruceWorxStart QPushButton#bwDashButton:checked {
  border-color: @AccentColor;
  color: @AccentColor;
  font-weight: 600;
}

#BruceWorxStart QPushButton#bwDashPrimary {
  border-color: @AccentColor;
  background-color: @AccentColor;
  color: @AccentTextColor;
  font-weight: 600;
}

#BruceWorxStart QPushButton#bwDashButton:disabled,
#BruceWorxStart QPushButton#bwDashPrimary:disabled {
  background-color: @GeneralDisabledBackgroundColor;
  border-color: @GeneralBorderColor;
  color: @TextDisabledColor;
}

#BruceWorxStart QFrame#bwDashTile,
#BruceWorxStart QFrame#bwDashCard {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

#BruceWorxStart QFrame#bwDashTile:hover {
  border-color: @AccentColor;
}

#BruceWorxStart QFrame#bwDashLegend {
  background: transparent;
  border: none;
}

#BruceWorxStart QLabel#bwDashTileTitle {
  color: @TextSecondaryColor;
  font-weight: 600;
}

#BruceWorxStart QLabel#bwDashNumber {
  font-size: 28px;
  font-weight: 700;
}

#BruceWorxStart QLabel#bwDashLegendText {
  color: @TextSecondaryColor;
  font-size: 12px;
}

#BruceWorxStart QFrame#bwDashLegend:hover QLabel {
  color: @TextForegroundColor;
}

#BruceWorxStart QWidget#bwDashHead {
  background: transparent;
  border: none;
  border-bottom: 1px solid @GeneralGridLinesColor;
}

#BruceWorxStart QLabel#bwDashTitle {
  font-size: 15px;
  font-weight: 700;
}

#BruceWorxStart QFrame#bwDashRow,
#BruceWorxStart QFrame#bwDashHealthRow {
  background: transparent;
  border: none;
  border-top: 1px solid @GeneralGridLinesColor;
}

#BruceWorxStart QFrame#bwDashRow[first="true"] {
  border-top: none;
}

#BruceWorxStart QFrame#bwDashFeedRow {
  background: transparent;
  border: none;
}

#BruceWorxStart QFrame#bwDashRow:hover,
#BruceWorxStart QFrame#bwDashFeedRow:hover,
#BruceWorxStart QFrame#bwDashHealthRow:hover {
  background-color: @HoverColor;
}

#BruceWorxStart QLabel#bwDashRowName {
  font-weight: 600;
  font-size: 13px;
}

#BruceWorxStart QLabel#bwDashRowSub,
#BruceWorxStart QLabel#bwDashTime {
  font-size: 12px;
}

#BruceWorxStart QWidget#bwDashTableHead {
  background-color: @HoverColor;
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
}

#BruceWorxStart QLabel#bwDashColumn,
#BruceWorxStart QLabel#bwDashDay {
  color: @TextDisabledColor;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

#BruceWorxStart QLabel#bwDashDay {
  padding: 6px 14px 2px 14px;
}

#BruceWorxStart QWidget#bwDashGroup {
  background: transparent;
  border: none;
  border-top: 1px solid @GeneralGridLinesColor;
}

#BruceWorxStart QLabel#bwDashGroupText {
  color: @TextSecondaryColor;
  font-size: 11px;
}

#BruceWorxStart QLabel#bwDashDot {
  font-size: 10px;
}

#BruceWorxStart QLabel#bwDashStep {
  border: 2px solid @GeneralBorderColor;
  border-radius: 14px;
  color: @TextSecondaryColor;
  font-weight: 700;
}

#BruceWorxStart QLabel#bwDashStep[done="true"] {
  border-color: @OkColor;
  background-color: @OkColor;
  color: #FFFFFF;
}

#BruceWorxStart QToolButton#bwDashMore {
  border: none;
  background: transparent;
  color: @TextSecondaryColor;
  padding: 0px 4px;
}

#BruceWorxStart QToolButton#bwDashMore::menu-indicator {
  image: none;
  width: 0px;
}

/* Navigation pill (bruceworx_navpill.py): a small card at the bottom of each 3D view ------------- */
#BruceWorxNavPill {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 9px;
}

#BruceWorxNavPill QToolButton {
  color: @TextSecondaryColor;
  background-color: transparent;
  border: none;
  border-radius: 6px;
  padding: 0px;
  margin: 0px;
}

/* Dark: the same faint plate as the toolbar icons. */
#BruceWorxNavPill[dark="true"] QToolButton {
  background-color: @IconPlateColor;
}

#BruceWorxNavPill QToolButton:hover {
  background-color: @HoverColor;
}

#BruceWorxNavPill QToolButton:pressed,
#BruceWorxNavPill QToolButton:checked {
  background-color: @AccentSoftColor;
  border: none;
}

#BruceWorxNavPill QToolButton:disabled {
  background-color: transparent;
}

#BruceWorxNavPill QToolButton::menu-indicator {
  image: none;
  width: 0px;
}

#BruceWorxNavPillSeparator {
  background-color: @GeneralBorderColor;
  border: none;
}

/* Undo toast (bruceworx_toasts.py): a small card above the navigation pill. */
#BruceWorxToast {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 9px;
}

QLabel#BruceWorxToastText {
  color: @TextForegroundColor;
  background: transparent;
}

QToolButton#BruceWorxToastUndo {
  color: @AccentColor;
  background-color: transparent;
  border: none;
  border-radius: 6px;
  padding: 3px 8px;
  font-weight: 600;
}

QToolButton#BruceWorxToastUndo:hover {
  background-color: @AccentSoftColor;
}

QToolButton#BruceWorxToastUndo:disabled {
  color: @TextDisabledColor;
}

/* On-canvas editing (bruceworx_oncanvas.py): value card at the arrow tip, command bar above the pill. */
#BruceWorxCanvasField,
#BruceWorxCanvasBar {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 9px;
}

#BruceWorxCanvasField QLineEdit {
  color: @TextForegroundColor;
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @AccentColor;
  border-radius: 6px;
  padding: 2px 6px;
  font-size: 13px;
}

#BruceWorxCanvasField QLineEdit:read-only {
  color: @TextSecondaryColor;
  border-color: @GeneralBorderColor;
}

#BruceWorxCanvasField QLabel,
QLabel#BruceWorxCanvasKeys {
  color: @TextSecondaryColor;
  background: transparent;
  font-size: 11px;
}

QLabel#BruceWorxCanvasTitle {
  color: @TextForegroundColor;
  background: transparent;
}

#BruceWorxCanvasBar QToolButton {
  color: @TextForegroundColor;
  background-color: transparent;
  border: none;
  border-radius: 6px;
  padding: 3px 8px;
}

#BruceWorxCanvasBar QToolButton:hover {
  background-color: @HoverColor;
}

QToolButton#BruceWorxCanvasSnap {
  color: @AccentColor;
}

QToolButton#BruceWorxCanvasDone {
  color: @AccentTextColor;
  background-color: @AccentColor;
  font-weight: 600;
}

QToolButton#BruceWorxCanvasDone:hover {
  color: @AccentTextColor;
  background-color: @AccentColor;
}

/* Sketch profile repair card (bruceworx_sketchrepair.py): top centre of the 3D view. */
#BruceWorxRepairCard {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-left: 3px solid @ErrorColor;
  border-radius: 9px;
}

#BruceWorxRepairCard QLabel {
  background: transparent;
}

QLabel#BruceWorxRepairCardTitle {
  color: @TextForegroundColor;
  font-weight: 600;
}

QLabel#BruceWorxRepairCardBody {
  color: @TextForegroundColor;
}

QLabel#BruceWorxRepairCardNote {
  color: @TextSecondaryColor;
}

QToolButton#BruceWorxRepairCardClose {
  color: @TextSecondaryColor;
  background-color: transparent;
  border: none;
  border-radius: 6px;
  padding: 0px 4px;
}

QToolButton#BruceWorxRepairCardClose:hover {
  background-color: @HoverColor;
}

/* Vault task dialogs (bruceworx_vaultwizard.py): problems at the foot of each task box. Errors block OK. */
QLabel#bwVaultHint,
QLabel#bwVaultIssue {
  color: @TextSecondaryColor;
}

QLabel#bwVaultIssue[level="error"] {
  color: @ErrorColor;
}

QLabel#bwVaultIssue[level="warning"] {
  color: @WarnColor;
}

/* Release checklist (bruceworx_changes.py): a mark per line; your ticks are plain checkboxes. */
QLabel#bwCheckMark {
  color: @TextSecondaryColor;
  font-weight: 700;
}

QLabel#bwCheckMark[state="ok"] {
  color: @OkColor;
}

QLabel#bwCheckMark[state="fail"] {
  color: @ErrorColor;
}

QLabel#bwCheckText[state="skip"] {
  color: @TextSecondaryColor;
}

QListWidget#bwChangeItems {
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 8px;
}

/* Part-number builder (bruceworx_vaultwizard.py): the number as clickable segments in a card. */
QFrame#bwPnCard {
  background-color: @GeneralBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

QFrame#bwPnSegment,
QFrame#bwPnRev {
  background-color: transparent;
  border: 1px solid transparent;
  border-bottom: 2px solid transparent;
  border-radius: 6px;
}

/* At most half the chip's height, or Qt draws square corners. */
QFrame#bwPnRev {
  border: 1px solid @GeneralBorderColor;
  border-radius: 9px;
  background-color: @CardBackgroundColor;
}

QFrame#bwPnSegment:hover,
QFrame#bwPnRev:hover {
  background-color: @HoverColor;
}

QFrame#bwPnSegment[selected="true"] {
  background-color: @AccentSoftColor;
  border-bottom-color: @AccentColor;
  border-bottom-left-radius: 0px;
  border-bottom-right-radius: 0px;
}

QFrame#bwPnRev[selected="true"] {
  background-color: @AccentSoftColor;
  border-color: @AccentColor;
}

QFrame#bwPnSegment:focus,
QFrame#bwPnRev:focus {
  border-color: @AccentColor;
}

QLabel#bwPnValue {
  color: @AccentColor;
  background: transparent;
}

QFrame#bwPnSegment[placeholder="true"] QLabel#bwPnValue,
QFrame#bwPnRev QLabel#bwPnValue,
QLabel#bwPnDash {
  color: @TextSecondaryColor;
  background: transparent;
}

QLabel#bwPnCaption,
QLabel#bwPnTitle,
QLabel#bwPnForm {
  color: @TextSecondaryColor;
  background: transparent;
}

QFrame#bwPnSegment[selected="true"] QLabel#bwPnCaption,
QFrame#bwPnRev[selected="true"] QLabel#bwPnCaption,
QFrame#bwPnRev[selected="true"] QLabel#bwPnValue {
  color: @AccentColor;
}

QLabel#bwPnPageTitle {
  font-weight: 600;
}

QLabel#bwPnSequence {
  color: @AccentColor;
}

/* Vault panel and Check In (bruceworx_vaultclient.py, BW-PDM-04). The list paints its rows
   itself; its colours come from these tokens (qproperty-*). */
QFrame#Vault {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

QWidget#bwVaultPanel,
QWidget#bwVaultTop {
  background: transparent;
}

QLabel#bwVaultCaption {
  color: @TextSecondaryColor;
  font-size: 11px;
  font-weight: 600;
}

QLabel#bwVaultName {
  color: @TextForegroundColor;
  font-size: 15px;
  font-weight: 600;
}

QLabel#bwVaultSync,
QLabel#bwVaultCount,
QToolButton#bwVaultSort,
QLabel#bwVaultFooter,
QLabel#bwVaultEmpty,
QLabel#bwVaultIntro {
  color: @TextSecondaryColor;
}

QLineEdit#bwVaultSearch {
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 8px;
  padding: 4px 6px;
}

QLineEdit#bwVaultSearch:focus {
  border-color: @AccentColor;
}

QPushButton#bwVaultChip {
  background-color: @CardBackgroundColor;
  color: @TextForegroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 11px;
  padding: 1px 6px;
  min-height: 18px;
}

QPushButton#bwVaultChip:hover {
  background-color: @HoverColor;
}

QPushButton#bwVaultChip:checked {
  background-color: @AccentColor;
  border-color: @AccentColor;
  color: @AccentTextColor;
  font-weight: 600;
}

QToolButton#bwVaultSort,
QToolButton#bwVaultTool {
  background: transparent;
  color: @TextSecondaryColor;
  border: none;
  padding: 2px;
}

QToolButton#bwVaultTool:hover,
QToolButton#bwVaultSort:hover {
  background-color: @HoverColor;
  border-radius: 5px;
}

QToolButton#bwVaultTool::menu-indicator {
  image: none;
  width: 0px;
}

QTreeView#bwVaultList {
  selection-background-color: transparent;
  show-decoration-selected: 0;
  background: transparent;
  border: none;
  border-top: 1px solid @GeneralBorderColor;
  qproperty-textColor: @TextForegroundColor;
  qproperty-secondaryColor: @TextSecondaryColor;
  qproperty-accentColor: @AccentColor;
  qproperty-okColor: @OkColor;
  qproperty-warnColor: @WarnColor;
  qproperty-errorColor: @ErrorColor;
  qproperty-borderColor: @GeneralBorderColor;
  qproperty-hoverColor: @HoverColor;
  qproperty-selectedColor: @AccentSoftColor;
  qproperty-cardColor: @CardBackgroundColor;
}

QTreeView#bwVaultList::item,
QTreeView#bwVaultList::item:hover,
QTreeView#bwVaultList::item:selected,
QTreeView#bwVaultList::branch:selected,
QTreeView#bwVaultList::branch:hover {
  background: transparent;
}

QLabel#bwVaultFooter {
  border-top: 1px solid @GeneralBorderColor;
}

QPlainTextEdit#bwVaultComment {
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 8px;
  padding: 3px;
}

QPlainTextEdit#bwVaultComment:focus {
  border: 2px solid @AccentColor;
  padding: 2px;
}

QTreeWidget#bwVaultFiles {
  background: transparent;
  border: none;
}

/* Properties tab of the right panel (bruceworx_inspector.py, UIX-12): folding sections with compact fields,
   as in a Fusion command dialog. */
QWidget#BruceWorxInspector QWidget#bwInspectorFoot {
  border-top: 1px solid @GeneralBorderColor;
}

QWidget#BruceWorxInspector QFrame#bwInspectorRule {
  color: @GeneralBorderColor;
  border: none;
  border-top: 1px solid @GeneralBorderColor;
  margin: 4px -12px 4px -12px;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorFold {
  background: transparent;
  border: none;
  padding: 0px;
  min-width: 12px;
  max-width: 12px;
  color: @TextDisabledColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorField {
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 5px;
  padding: 1px 7px;
  min-height: 18px;
  text-align: left;
  color: @TextForegroundColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorField:hover {
  border-color: @AccentColor;
}

QWidget#BruceWorxInspector QScrollArea#bwInspectorScroll,
QWidget#BruceWorxInspector QWidget#bwInspectorBody {
  background: transparent;
  border: none;
}

QWidget#BruceWorxInspector QLabel#bwInspectorCaption {
  color: @TextDisabledColor;
}

QWidget#BruceWorxInspector QLabel#bwInspectorSub,
QWidget#BruceWorxInspector QLabel#bwInspectorLabel,
QWidget#BruceWorxInspector QLabel#bwInspectorHint {
  color: @TextSecondaryColor;
}

QWidget#BruceWorxInspector QLabel#bwInspectorValue {
  color: @TextForegroundColor;
}

QWidget#BruceWorxInspector QLineEdit,
QWidget#BruceWorxInspector QAbstractSpinBox,
QWidget#BruceWorxInspector QComboBox {
  min-height: 18px;
  max-height: 22px;
  padding-top: 0px;
  padding-bottom: 0px;
}

QWidget#BruceWorxInspector QFrame#bwInspectorSegments {
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  background-color: @TextEditFieldBackgroundColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorSegment {
  background-color: transparent;
  border: none;
  border-left: 1px solid @GeneralBorderColor;
  border-radius: 0px;
  padding: 0px 6px;
  min-height: 20px;
  max-height: 20px;
  color: @TextSecondaryColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorSegment[position="first"] {
  border-left: none;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorSegment[position="last"] {
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorSegment:hover {
  background-color: @HoverColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorSegment:checked {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
  font-weight: 600;
}

/* Links as chips: a click selects the linked object. At most half the height as radius. */
QWidget#BruceWorxInspector QToolButton#bwInspectorChip {
  background-color: @HoverColor;
  border: 1px solid transparent;
  border-radius: 9px;
  padding: 1px 8px 1px 4px;
  min-height: 16px;
  max-height: 18px;
  color: @TextForegroundColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorChip:hover {
  border-color: @AccentColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorAction,
QWidget#BruceWorxInspector QPushButton#bwInspectorAction {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  padding: 2px 10px;
  min-height: 18px;
  color: @TextForegroundColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorAction:hover,
QWidget#BruceWorxInspector QPushButton#bwInspectorAction:hover {
  background-color: @HoverColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorMenu,
QWidget#BruceWorxInspector QToolButton#bwInspectorSwatch {
  background: transparent;
  border: none;
  border-radius: 4px;
  padding: 1px 4px;
  color: @TextForegroundColor;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorMenu::menu-indicator {
  image: none;
  width: 0px;
}

QWidget#BruceWorxInspector QToolButton#bwInspectorMenu:hover,
QWidget#BruceWorxInspector QToolButton#bwInspectorSwatch:hover {
  background-color: @HoverColor;
}

QToolButton#bwInspectorMore,
QToolButton#bwInspectorBack {
  background: transparent;
  border: none;
  padding: 2px 4px;
  color: @AccentColor;
  font-weight: 600;
}

QToolButton#bwInspectorMore:hover,
QToolButton#bwInspectorBack:hover {
  color: @AccentHoverColor;
}

/* Right panel tabs (bruceworx_rightpanel.py, UIX-12): a thin strip of text tabs over the panel's title bar,
   the current one in the text colour with an accent underline; the command's tab on the right. */
QWidget#bwRightTabs {
  background-color: @CardBackgroundColor;
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
  border-top-left-radius: 9px;
  border-top-right-radius: 9px;
}

QWidget#bwRightTabs QToolButton#bwRightTab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  padding: 0px 6px;
  margin: 0px;
  font-size: 11px;
  font-weight: 600;
  color: @TextSecondaryColor;
}

QWidget#bwRightTabs QToolButton#bwRightTab:hover {
  color: @TextForegroundColor;
}

QWidget#bwRightTabs QToolButton#bwRightTab[current="true"] {
  color: @TextForegroundColor;
  border-bottom-color: @AccentColor;
}

QWidget#bwRightTabs QToolButton#bwRightTab[kind="command"] {
  color: @AccentColor;
}

QWidget#bwRightTabs QToolButton#bwRightTab[kind="command"][current="true"] {
  color: @TextForegroundColor;
}

/* Physical tab of the right panel (bruceworx_physical.py, UIX-12): the Properties tab's sections, read-only. */
QWidget#BruceWorxPhysical QWidget#bwInspectorFoot {
  border-top: 1px solid @GeneralBorderColor;
}

QWidget#BruceWorxPhysical QFrame#bwInspectorRule {
  color: @GeneralBorderColor;
  border: none;
  border-top: 1px solid @GeneralBorderColor;
  margin: 4px -12px 4px -12px;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorFold {
  background: transparent;
  border: none;
  padding: 0px;
  min-width: 12px;
  max-width: 12px;
  color: @TextDisabledColor;
}

QWidget#BruceWorxPhysical QScrollArea#bwInspectorScroll,
QWidget#BruceWorxPhysical QWidget#bwInspectorBody {
  background: transparent;
  border: none;
}

QWidget#BruceWorxPhysical QLabel#bwInspectorSub,
QWidget#BruceWorxPhysical QLabel#bwInspectorLabel,
QWidget#BruceWorxPhysical QLabel#bwInspectorHint {
  color: @TextSecondaryColor;
}

QWidget#BruceWorxPhysical QLabel#bwInspectorValue {
  color: @TextForegroundColor;
}

QWidget#BruceWorxPhysical QFrame#bwInspectorSegments {
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  background-color: @TextEditFieldBackgroundColor;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorSegment {
  background-color: transparent;
  border: none;
  border-left: 1px solid @GeneralBorderColor;
  border-radius: 0px;
  padding: 0px 6px;
  min-height: 20px;
  max-height: 20px;
  color: @TextSecondaryColor;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorSegment[position="first"] {
  border-left: none;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorSegment[position="last"] {
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorSegment:hover {
  background-color: @HoverColor;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorSegment:checked {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
  font-weight: 600;
}

QWidget#BruceWorxPhysical QToolButton#bwInspectorMore:disabled {
  color: @TextDisabledColor;
}

/* Parameters tab of the right panel (bruceworx_parameters.py, UIX-12): a filter over a Name / Expression / Value
   table; group rows banded, expressions in a fixed-width font. */
QWidget#BruceWorxParameters QWidget#bwParamFoot {
  border-top: 1px solid @GeneralBorderColor;
}

QWidget#BruceWorxParameters QLineEdit#bwParamFilter {
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 6px;
  padding: 0px 6px;
}

QWidget#BruceWorxParameters QLineEdit#bwParamFilter:focus {
  border-color: @AccentColor;
}

QWidget#BruceWorxParameters QLabel#bwParamError,
QDialog#bwParamDialog QLabel#bwParamError {
  color: @ErrorColor;
}

QWidget#BruceWorxParameters QLabel#bwParamHint {
  color: @TextSecondaryColor;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree {
  background: transparent;
  border: none;
  outline: none;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree::item {
  min-height: 22px;
  padding: 0px 2px;
  border-bottom: 1px solid @HoverColor;
  color: @TextForegroundColor;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree::item:hover {
  background-color: @HoverColor;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree::item:selected {
  background-color: @AccentSoftColor;
  color: @TextForegroundColor;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree QHeaderView::section {
  background: transparent;
  border: none;
  border-bottom: 1px solid @GeneralBorderColor;
  padding: 3px 4px;
  font-size: 11px;
  font-weight: 600;
  color: @TextSecondaryColor;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree QLineEdit#bwParamEditor {
  background-color: @TextEditFieldBackgroundColor;
  border: 1px solid @AccentColor;
  border-radius: 4px;
  padding: 0px 3px;
}

QWidget#BruceWorxParameters QWidget#bwParamGroupHead {
  background: transparent;
}

QWidget#BruceWorxParameters QToolButton#bwParamPlus {
  background: transparent;
  border: none;
  padding: 0px 6px;
  font-size: 15px;
  font-weight: 600;
  color: @AccentColor;
}

QWidget#BruceWorxParameters QToolButton#bwParamPlus:hover {
  color: @AccentHoverColor;
}

QWidget#BruceWorxParameters QTreeWidget#bwParamTree::branch:closed:has-children,
QWidget#BruceWorxParameters QTreeWidget#bwParamTree::branch:open:has-children {
  padding: 3px;
}

/* Create Vault as a full-window tab (bruceworx_vaultwizard.py): a centred column of section cards on the
   window background, and a bar with Cancel / Create at the bottom. */
QWidget#BruceWorxCreateVaultPage,
QWidget#BruceWorxCreateVaultPage QScrollArea#bwVaultPageScroll,
QWidget#BruceWorxCreateVaultPage QWidget#bwVaultPageBody {
  background-color: @GeneralBackgroundColor;
}

QWidget#BruceWorxCreateVaultPage QLabel#bwVaultPageTitle {
  color: @TextForegroundColor;
}

QWidget#BruceWorxCreateVaultPage QLabel#bwVaultPageIntro {
  color: @TextSecondaryColor;
}

QWidget#BruceWorxCreateVaultPage QFrame#bwVaultPageCard {
  background-color: @CardBackgroundColor;
  border: 1px solid @GeneralBorderColor;
  border-radius: 10px;
}

QWidget#BruceWorxCreateVaultPage QLabel#bwVaultPageStep {
  color: @TextForegroundColor;
}

QWidget#BruceWorxCreateVaultPage QFrame#bwVaultPageBar {
  background-color: @CardBackgroundColor;
  border: none;
  border-top: 1px solid @GeneralBorderColor;
}
