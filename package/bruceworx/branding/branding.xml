<?xml version="1.0" encoding="utf-8"?>
<!-- [BW] Vector Labs branding for the DEVELOPMENT build (build/release), read by App::Application from
     <home>/bin/branding.xml at start. Only the splash screen is branded here; the application and
     executable names stay FreeCAD's so the development build keeps its own settings. make-vectorlabs.sh
     writes the full branding (names, settings folders) for Vector Labs.app. The splash images live in
     <home>/icons (vectorlabs_splash.png, vectorlabs_splash_2x.png for Retina); the version is drawn into
     the image by render_splash.sh, so FreeCAD's own name/version overlay is drawn fully transparent. -->
<Branding>
  <SplashScreen>vectorlabs_splash</SplashScreen>
  <SplashInfoColor>#00000000</SplashInfoColor>
  <SplashAlignment>Bottom|Left</SplashAlignment>
  <SplashTextColor>#8a97a8</SplashTextColor>
</Branding>
