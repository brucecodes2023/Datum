<?xml version="1.0" encoding="utf-8"?>
<!-- Heuretes FreeCAD splash for the development build (build/release).
     App::Application reads <home>/bin/branding.xml at start. Only the splash is
     branded here; the executable name stays FreeCAD so this build keeps its own
     settings. make-heuretes.sh writes the full name for Heuretes FreeCAD.app.
     Images: <home>/icons/heuretes_splash.png and heuretes_splash_2x.png.
     The version is already drawn into the image, so FreeCAD's overlay is transparent. -->
<Branding>
  <SplashScreen>heuretes_splash</SplashScreen>
  <SplashInfoColor>#00000000</SplashInfoColor>
  <SplashAlignment>Bottom|Left</SplashAlignment>
  <SplashTextColor>#5a6068</SplashTextColor>
</Branding>
